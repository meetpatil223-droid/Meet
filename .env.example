# ===================================================================
# CLOUD DEPLOYMENT (Render / Vercel / Railway) - RECOMMENDED
# ===================================================================
# Cloud platforms block direct SMTP ports (587/465). Use Resend HTTPS API:
# 1. Sign up for free at https://resend.com (3,000 free emails/month)
# 2. Generate an API Key under "API Keys"
# 3. Add these variables in your Render Dashboard -> Environment:
RESEND_API_KEY=re_123456789abcdef
RESEND_TO_EMAIL=meetpatil223@gmail.com

# NOTE FOR RESEND FREE TIER:
# If you don't have a custom domain, emails are sent to the exact email
# address you registered your Resend account with.

# ===================================================================
# SUPABASE DATABASE CONFIGURATION (Persistent Storage)
# ===================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# ===================================================================
# LOCAL DEVELOPMENT ONLY (Direct Gmail SMTP)
# ===================================================================
# Only works in local development (blocked on cloud servers like Render)
EMAIL_USER=meetpatil223@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
TO_EMAIL=meetpatil223@gmail.com

